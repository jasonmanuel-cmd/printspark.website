# Neon (Postgres)
DATABASE_URL=postgresql://user:pass@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Square Payments
NEXT_PUBLIC_SQUARE_APPLICATION_ID=sandbox-sq0idb-XXXXXX
SQUARE_ACCESS_TOKEN=EAAAl...
SQUARE_ENVIRONMENT=sandbox
SQUARE_LOCATION_ID=LXXXXXX
SQUARE_WEBHOOK_SIGNATURE_KEY=your-webhook-signature-key

# Resend Email
RESEND_API_KEY=re_your_api_key
FROM_EMAIL=orders@printspark.website

# Business
NEXT_PUBLIC_BUSINESS_EMAIL=hello@printspark.website
NEXT_PUBLIC_BUSINESS_PHONE=(888) 774-6877

# Printful (apparel/stickers/posters)
PRINTFUL_API_KEY=your_printful_oauth_bearer_token
PRINTFUL_VARIANT_MAP={}

# Mixam (commercial print: business cards, flyers, brochures, postcards)
MIXAM_API_KEY=your_mixam_api_key

# Shipping (EasyPost or Shippo)
SHIPPING_API_KEY=your_shipping_api_key

# App URLs
NEXT_PUBLIC_APP_URL=https://printspark.website
NEXT_PUBLIC_BASE_URL=https://printspark.website
